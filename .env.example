# Formspree — copiá este archivo como ".env" y completá el valor
#
# Pasos:
#   1. Creá cuenta en https://formspree.io
#   2. New Form → dale un nombre (ej: "Portfolio Contact")
#   3. Copiá el ID del endpoint — es la parte final de la URL:
#      https://formspree.io/f/ESTE_ES_EL_ID
#
REACT_APP_FORMSPREE_ID=tu_form_id
